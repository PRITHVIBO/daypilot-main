Options -Indexes

<FilesMatch "^(config|config\.example|config\.local|database|composer)\.(php|json|sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.(env|git|htaccess)">
  Require all denied
</FilesMatch>

# Preserve scoped connector authorization through Apache/PHP.
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
